import {test,expect,type Page} from '@playwright/test';
import fs from 'node:fs';
import path from 'node:path';
import {DatabaseSync} from 'node:sqlite';
import {backendFixture,owner,request} from './helpers/security-process.mjs';
import {seedPmReportHistory} from './helpers/pm-history-report-data.mjs';
type Library='machine'|'equipment';
async function fixture(page:Page,label:string){
 const runtime=await backendFixture(`pm-report-${label}`,{}, {serveFrontend:true});
 try{const cookie=await owner(runtime.base),assets:any={};for(const library of ['machine','equipment'])for(const other of [false,true]){const key=`${library}${other?'Other':''}`;const result=await request(runtime.base,`/api/${library}-library/assets`,{method:'POST',cookie,body:{assetNumber:`${library==='machine'?'Press':'Dryer'}-${other?'Other':'7001'}`,assetName:'Synthetic Report Press',equipmentName:'Synthetic Report Dryer',brand:'MCC QA',manufacturer:'MCC QA',model:'Report-300',serialNumber:'QA-ONLY',status:'active',category:'Dryer'}});expect(result.response.status).toBe(201);assets[key]=result.data.asset;}
 const db=new DatabaseSync(path.join(runtime.fixture,'data/mcc.sqlite'));const groups=await seedPmReportHistory(db,runtime,assets);const snapshot=Object.fromEntries(['pm_history','pm_tasks','pm_work_order_attachments','pm_asset_meters','pm_meter_history','pm_history_participants'].map(table=>[table,db.prepare(`SELECT * FROM ${table} ORDER BY id`).all()]));db.close();await page.context().addCookies([{name:cookie.split('=')[0],value:cookie.slice(cookie.indexOf('=')+1),url:runtime.base}]);return{runtime,groups,snapshot};
 }catch(error){await runtime.close();throw error;}
}
async function openHistory(page:Page,runtime:any,library:Library,view:'task'|'asset'){
 await page.goto(`${runtime.base}/${library}-library`);
 if(library==='machine')await page.getByRole('button',{name:'View details for Press-7001',exact:true}).click();else await page.getByRole('button',{name:/^Open Equipment Dryer-7001,/}).click();
 await page.getByRole('button',{name:/^Preventive Maintenance Tracking/}).click();
 if(view==='asset')await page.getByRole('button',{name:'All PM History',exact:true}).click();else{const card=page.locator('.pm-task-card').filter({hasText:'Lubrication QA'});await card.locator('summary').click();await card.getByRole('menuitem',{name:'History (5)',exact:true}).click();}
 const dialog=page.getByRole('dialog',{name:view==='asset'?`${library==='machine'?'Press':'Dryer'}-7001 PM History`:'Lubrication QA',exact:true});await expect(dialog.getByRole('checkbox')).toHaveCount(view==='asset'?6:5);return dialog;
}
function preserved(runtime:any,snapshot:any){const db=new DatabaseSync(path.join(runtime.fixture,'data/mcc.sqlite'));for(const [table,rows]of Object.entries(snapshot))expect(db.prepare(`SELECT * FROM ${table} ORDER BY id`).all()).toEqual(rows);db.close();}
for(const library of ['machine','equipment']as const)for(const view of ['task','asset']as const)test(`${library} ${view} history selects exact month/IDs, downloads and prints the same report with keyboard/mobile controls`,async({page,isMobile},testInfo)=>{
 const {runtime,groups,snapshot}=await fixture(page,`${library}-${view}`);const group=groups[library],requests:any[]=[],consoleErrors:string[]=[];
 page.on('console',message=>{if(message.type()==='error')consoleErrors.push(message.text());});page.on('pageerror',error=>consoleErrors.push(error.message));page.on('request',req=>{if(req.url().endsWith('/history/report.pdf'))requests.push(req.postDataJSON());expect(req.method()).not.toBe('DELETE');});
 try{
  const dialog=await openHistory(page,runtime,library,view);await expect(dialog.getByRole('button',{name:'Download PDF',exact:true})).toBeDisabled();await expect(dialog.getByRole('button',{name:'Print Selected',exact:true})).toBeDisabled();await expect(dialog.getByRole('button',{name:'Close',exact:true}).first()).toBeFocused();
  const month=dialog.getByRole('combobox',{name:'Completion Month',exact:true});await month.selectOption('2026-10');await dialog.getByRole('button',{name:'Select Month',exact:true}).click();const expected=group.records.filter((record:any)=>record.completionDate.startsWith('2026-10')&&(view==='asset'||record.pmTaskId===group.tasks[0])).map((record:any)=>record.id);
  await expect(dialog.getByRole('checkbox',{checked:true})).toHaveCount(expected.length);await expect(dialog.locator('output')).toHaveText(`${expected.length} selected`);for(const id of expected)await expect(dialog.getByRole('checkbox',{name:new RegExp(`^Select completion #${id} on `)})).toBeChecked();await expect(dialog.getByRole('checkbox',{name:new RegExp(`^Select completion #${group.records[0].id} on `)})).not.toBeChecked();
  // Month selection uses all loaded records, including the same-day row below a long note.
  const downloadPromise=page.waitForEvent('download');await dialog.getByRole('button',{name:'Download PDF',exact:true}).click();const download=await downloadPromise;const destination=testInfo.outputPath(`${library}-${view}.pdf`);await download.saveAs(destination);expect(await download.failure()).toBeNull();expect(download.suggestedFilename()).toContain('October-2026.pdf');expect(fs.readFileSync(destination).subarray(0,5).toString()).toBe('%PDF-');expect(requests.at(-1).completionIds).toEqual([...expected].sort((a,b)=>a-b));expect(requests.at(-1).pmTaskId).toBe(view==='task'?group.tasks[0]:undefined);
  const printed=page.context().waitForEvent('page');await dialog.getByRole('button',{name:'Print Selected',exact:true}).click();const printPage=await printed;await expect(printPage.getByRole('button',{name:'Print PDF',exact:true})).toBeVisible();await expect(printPage.getByRole('link',{name:'Open PDF',exact:true})).toHaveAttribute('href',/^blob:/);await expect(printPage.locator('iframe')).toHaveAttribute('src',/^blob:/);expect(requests.at(-1).completionIds).toEqual([...expected].sort((a,b)=>a-b));expect(await printPage.evaluate(()=>window.opener)).toBeNull();
  const printedBytes=await printPage.evaluate(async()=>Array.from(new Uint8Array(await(await fetch(document.querySelector('iframe')!.src)).arrayBuffer())));expect(Buffer.from(printedBytes).subarray(0,5).toString()).toBe('%PDF-');
  // Closing the source modal leaves the owned print report usable.
  await dialog.getByRole('button',{name:'Clear Selection',exact:true}).click();await expect(dialog.locator('output')).toHaveText('0 selected');const arbitrary=dialog.getByRole('checkbox',{name:new RegExp(`^Select completion #${group.records[0].id} on `)});await arbitrary.focus();await page.keyboard.press('Space');await expect(arbitrary).toBeChecked();await dialog.getByRole('checkbox',{name:new RegExp(`^Select completion #${group.records[1].id} on `)}).check();await expect(dialog.locator('output')).toHaveText('2 selected');
  await month.selectOption('2025-10');await dialog.getByRole('button',{name:'Select Month',exact:true}).click();await expect(dialog.locator('output')).toHaveText('2 selected');
  const selectedDates=page.waitForEvent('download');await dialog.getByRole('button',{name:'Download PDF',exact:true}).click();const different=await selectedDates;expect(different.suggestedFilename()).toContain('Selected-Dates.pdf');expect(requests.at(-1).completionIds).toEqual([group.records[0].id,group.records[1].id].sort((a,b)=>a-b));
  await dialog.screenshot({path:testInfo.outputPath(`${library}-${view}-selection.png`)});expect(await dialog.evaluate(element=>element.scrollWidth-element.clientWidth)).toBeLessThanOrEqual(1);await dialog.getByRole('button',{name:'Close',exact:true}).last().focus();await page.keyboard.press('Tab');await expect(dialog.getByRole('button',{name:'Close',exact:true}).first()).toBeFocused();await page.keyboard.press('Escape');await expect(dialog).toHaveCount(0);expect(await printPage.evaluate(async()=>(await fetch(document.querySelector('iframe')!.src)).status)).toBe(200);await printPage.close();
  expect(consoleErrors).toEqual([]);preserved(runtime,snapshot);await testInfo.attach('report-request-review.json',{body:JSON.stringify(requests,null,2),contentType:'application/json'});
 }finally{await runtime.close();}
});

for(const library of ['machine','equipment']as const)test(`${library} history handles blocked popups, generation failures and empty history without losing selection`,async({page},testInfo)=>{
 const {runtime,groups,snapshot}=await fixture(page,`${library}-errors`);
 try{const dialog=await openHistory(page,runtime,library,'task');const id=groups[library].records[2].id;await dialog.getByRole('checkbox',{name:new RegExp(`^Select completion #${id} on `)}).check();
 await page.evaluate(()=>{window.open=()=>null;});await dialog.getByRole('button',{name:'Print Selected',exact:true}).click();await expect(dialog.getByRole('link',{name:'Open PDF for printing',exact:true})).toHaveAttribute('href',/^blob:/);await expect(dialog.getByText(/print window was blocked or closed/)).toBeVisible();await expect(dialog.getByRole('checkbox',{checked:true})).toHaveCount(1);
 await page.route('**/history/report.pdf',route=>route.fulfill({status:500,json:{ok:false,error:'The PM history report could not be generated.'}}));await dialog.getByRole('button',{name:'Download PDF',exact:true}).click();await expect(dialog.getByRole('alert')).toHaveText(/could not be generated/);await expect(dialog.getByRole('checkbox',{checked:true})).toHaveCount(1);await page.unroute('**/history/report.pdf');
 await dialog.screenshot({path:testInfo.outputPath(`${library}-report-error.png`)});await page.keyboard.press('Escape');const card=page.locator('.pm-task-card').filter({hasText:'Safety QA'});await card.locator('summary').click();await card.getByRole('menuitem',{name:'History (1)',exact:true}).click();const safety=page.getByRole('dialog',{name:'Safety QA',exact:true});await expect(safety.locator('output')).toHaveText('0 selected');await page.keyboard.press('Escape');
 await page.route(`**/api/${library}-library/preventive-maintenance/${groups[library].tasks[0]}/history`,route=>route.fulfill({json:{ok:true,history:[]}}));const first=page.locator('.pm-task-card').filter({hasText:'Lubrication QA'});await first.locator('summary').click();await first.getByRole('menuitem',{name:'History (5)',exact:true}).click();const empty=page.getByRole('dialog',{name:'Lubrication QA',exact:true});await expect(empty.getByRole('checkbox')).toHaveCount(0);await expect(empty.getByRole('button',{name:'Select Month',exact:true})).toBeDisabled();await expect(empty.getByRole('button',{name:'Download PDF',exact:true})).toBeDisabled();preserved(runtime,snapshot);
 }finally{await runtime.close();}
});
