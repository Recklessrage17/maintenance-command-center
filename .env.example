# MCC local auth/session configuration
SESSION_SECRET=replace-with-a-long-random-secret

# Supported Raspberry Pi HTTPS deployments terminate TLS in Caddy and bind
# this Node service to loopback. MCC_HTTPS_HOSTNAME is the canonical browser
# hostname shared by Caddy and Settings > Network Access. Leave both unset for
# legacy/local development.
# MCC_BIND_HOST=127.0.0.1
# MCC_HTTPS_MODE=internal
# MCC_HTTPS_HOSTNAME=mcc.local

# Optional SMTP settings for forgot-password emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional PM Excel runtime storage override. Defaults to backend/data/pm-excel.
# Keep this on persistent local storage; it contains synchronized reports and known-good backups.
MCC_PM_EXCEL_DIR=

# Persistent MCC operational-data paths. Production paths should live outside the Git checkout.
# MCC_DATA_DIR=/var/lib/mcc/data
# MCC_UPLOADS_DIR=/var/lib/mcc/uploads
# MCC_BACKUPS_DIR=/var/lib/mcc/backups
# MCC_PM_WORK_ORDER_DIR=/var/lib/mcc/pm-work-orders
# MCC_RECOVERY_DIR=/var/lib/mcc-recovery
# Maximum compressed portable-backup creation/import size in MB (default 3072, maximum 3584).
# This verified classic-ZIP envelope supports a 1 GB video plus a 500 MB file and recovery headroom without ZIP64.
# MCC_PORTABLE_BACKUP_MAX_MB=3072
# MCC-owned imported recovery storage is bounded without automatic deletion.
# Defaults: 8192 MB total and 3 retained imported packages.
# MCC_RECOVERY_QUOTA_MB=8192
# MCC_RECOVERY_MAX_PACKAGES=3

# Shared Facility, Machine, and Equipment library upload ceilings.
# Machine and Equipment use these fixed defaults; Facility may be lowered for constrained deployments.
# MCC_FACILITY_DOCUMENT_MAX_MB=500
# MCC_FACILITY_PICTURE_MAX_MB=500
# MCC_FACILITY_VIDEO_MAX_MB=1024

# One-click updater. Leave disabled on development/master copies.
# Raspberry Pi production:
# MCC_UPDATE_MODE=raspberry_pi
# MCC_UPDATE_APP_DIR=/opt/maintenance-command-center
# MCC_UPDATE_STATE_DIR=/var/lib/mcc-update
#
# Isolated Windows test copy only (never F:\MCC_V1_FINAL):
# MCC_UPDATE_MODE=windows_test
# MCC_UPDATE_APP_DIR=Z:\MCC_V1_FINAL
# MCC_UPDATE_STATE_DIR=Z:\MCC_UPDATE\state
# MCC_UPDATE_WINDOWS_RUNNER=Z:\MCC_UPDATE\Invoke-MccTestUpdate.ps1
# MCC_UPDATE_WINDOWS_CONFIG=Z:\MCC_UPDATE\config.json
