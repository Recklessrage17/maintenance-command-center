#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONFIG_FILE="/etc/mcc-mdns.env"
readonly AVAHI_HOSTS="/etc/avahi/hosts"
readonly BACKUP_FILE="/var/backups/mcc-avahi-hosts.preinstall"
readonly PUBLISHER_SERVICE="mcc-mdns-publisher.service"

fail() {
  echo "MCC mDNS install failed: $*" >&2
  exit 1
}

render_avahi_hosts_without_alias() {
  local source_file="$1"
  local target_hostname="$2"
  awk -v target="${target_hostname,,}" '
    {
      comment_start = NF + 1
      target_found = 0
      for (field = 2; field <= NF; field++) {
        if ($field ~ /^#/) {
          comment_start = field
          break
        }
        if (tolower($field) == target) target_found = 1
      }
      if (!target_found) {
        print
        next
      }
      output = $1
      kept = 0
      for (field = 2; field < comment_start; field++) {
        if (tolower($field) != target) {
          output = output " " $field
          kept++
        }
      }
      if (comment_start <= NF) {
        comment = $comment_start
        for (field = comment_start + 1; field <= NF; field++) comment = comment " " $field
        if (kept > 0) output = output " " comment
        else output = comment
      }
      if (kept > 0 || comment_start <= NF) print output
    }
  ' "${source_file}"
}

if [[ "${1:-}" == "--render-avahi-hosts" ]]; then
  [[ "$#" -eq 3 ]] || fail "usage: install-mcc-mdns --render-avahi-hosts <hosts-file> <hostname>"
  [[ -r "$2" ]] || fail "missing readable $2"
  [[ "${3,,}" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*\.local$ ]] \
    || fail "hostname must be a valid .local FQDN"
  render_avahi_hosts_without_alias "$2" "$3"
  exit 0
fi
[[ "$#" -eq 0 ]] || fail "usage: install-mcc-mdns [--render-avahi-hosts <hosts-file> <hostname>]"

if [[ "${EUID}" -ne 0 ]]; then
  fail "run as root"
fi
if [[ ! -r "${CONFIG_FILE}" || "$(stat -c '%U:%G:%a' "${CONFIG_FILE}")" != "root:root:644" ]]; then
  fail "${CONFIG_FILE} must be readable and owned by root:root with mode 0644"
fi

# shellcheck source=/dev/null
source "${CONFIG_FILE}"
: "${MCC_MDNS_HOSTNAME:?MCC_MDNS_HOSTNAME is required}"
: "${MCC_MDNS_ADDRESS:?MCC_MDNS_ADDRESS is required}"
: "${MCC_MDNS_INTERFACE:?MCC_MDNS_INTERFACE is required}"

MCC_MDNS_HOSTNAME="${MCC_MDNS_HOSTNAME,,}"
if [[ ! "${MCC_MDNS_HOSTNAME}" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*\.local$ ]]; then
  fail "MCC_MDNS_HOSTNAME must be a valid .local FQDN"
fi
if [[ ! "${MCC_MDNS_ADDRESS}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
  fail "MCC_MDNS_ADDRESS must be an IPv4 address"
fi
IFS=. read -r address_a address_b address_c address_d <<< "${MCC_MDNS_ADDRESS}"
for octet in "${address_a}" "${address_b}" "${address_c}" "${address_d}"; do
  (( 10#${octet} <= 255 )) || fail "MCC_MDNS_ADDRESS contains an invalid IPv4 octet"
done
if [[ ! "${MCC_MDNS_INTERFACE}" =~ ^[A-Za-z0-9_.:-]+$ ]]; then
  fail "MCC_MDNS_INTERFACE contains unsupported characters"
fi
command -v avahi-resolve-host-name >/dev/null || fail "install avahi-utils"
command -v avahi-publish-address >/dev/null || fail "install avahi-utils (avahi-publish-address is missing)"
avahi-publish-address --help 2>&1 | grep -Eq -- '-R[[:space:]]+--no-reverse' \
  || fail "installed avahi-publish-address does not support -R/--no-reverse"
dpkg-query -W -f='${db:Status-Status}' avahi-daemon 2>/dev/null | grep -Fxq 'installed' || fail "install avahi-daemon"
ip link show dev "${MCC_MDNS_INTERFACE}" >/dev/null 2>&1 || fail "interface ${MCC_MDNS_INTERFACE} does not exist"
ip -4 -o addr show dev "${MCC_MDNS_INTERFACE}" scope global | awk '{print $4}' | cut -d/ -f1 | grep -Fxq "${MCC_MDNS_ADDRESS}" \
  || fail "${MCC_MDNS_ADDRESS} is not assigned to ${MCC_MDNS_INTERFACE}; correct the reservation/configuration before advertising"

[[ -x /usr/local/sbin/migrate-mcc-https-env ]] || fail "install /usr/local/sbin/migrate-mcc-https-env"
[[ -x /usr/local/sbin/publish-mcc-mdns ]] || fail "install /usr/local/sbin/publish-mcc-mdns"
[[ -r "/etc/systemd/system/${PUBLISHER_SERVICE}" ]] || fail "install /etc/systemd/system/${PUBLISHER_SERVICE}"
[[ "$(stat -c '%U:%G:%a' "/etc/systemd/system/${PUBLISHER_SERVICE}")" == "root:root:644" ]] \
  || fail "/etc/systemd/system/${PUBLISHER_SERVICE} must be owned by root:root with mode 0644"

/usr/local/sbin/migrate-mcc-https-env
systemctl daemon-reload
systemctl enable --now avahi-daemon.service
systemctl stop "${PUBLISHER_SERVICE}" 2>/dev/null || true

install -d -o root -g root -m 0755 /etc/avahi /var/backups
if [[ -e "${AVAHI_HOSTS}" && ! -e "${BACKUP_FILE}" ]]; then
  install -o root -g root -m 0644 "${AVAHI_HOSTS}" "${BACKUP_FILE}"
fi

if [[ -r "${AVAHI_HOSTS}" ]]; then
  [[ "$(stat -c '%U:%G:%a' "${AVAHI_HOSTS}")" == "root:root:644" ]] \
    || fail "${AVAHI_HOSTS} must be owned by root:root with mode 0644"
  temporary_hosts="$(mktemp /etc/avahi/hosts.mcc.XXXXXX)"
  trap 'rm -f "${temporary_hosts:-}"' EXIT
  render_avahi_hosts_without_alias "${AVAHI_HOSTS}" "${MCC_MDNS_HOSTNAME}" > "${temporary_hosts}"
  if ! cmp --silent "${AVAHI_HOSTS}" "${temporary_hosts}"; then
    install -o root -g root -m 0644 "${temporary_hosts}" "${AVAHI_HOSTS}"
    systemctl restart avahi-daemon.service
  fi
  rm -f "${temporary_hosts}"
  trap - EXIT
fi

# The supervised publisher performs another exact-name preflight immediately
# before registration and exits if Avahi tries to select a suffixed alias.
systemctl reset-failed "${PUBLISHER_SERVICE}" 2>/dev/null || true
systemctl enable --now "${PUBLISHER_SERVICE}"
/usr/local/sbin/validate-mcc-network
echo "MCC no-reverse mDNS publisher installed: ${MCC_MDNS_HOSTNAME} -> ${MCC_MDNS_ADDRESS}."
