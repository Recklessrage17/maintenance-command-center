#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONFIG_FILE="/etc/mcc-https.env"
readonly CADDYFILE="/etc/caddy/Caddyfile"
readonly DNS_ENV_FILE="/etc/mcc-https-dns.env"

if [[ "${EUID}" -ne 0 ]]; then
  echo "Run this validator as root." >&2
  exit 77
fi
if [[ ! -r "${CONFIG_FILE}" || ! -r "${CADDYFILE}" ]]; then
  echo "Missing ${CONFIG_FILE} or ${CADDYFILE}." >&2
  exit 78
fi
for protected_path in "${CONFIG_FILE}" "${CADDYFILE}"; do
  if [[ "$(stat -c '%U:%G:%a' "${protected_path}")" != "root:root:644" ]]; then
    echo "${protected_path} must be owned by root:root with mode 0644." >&2
    exit 78
  fi
done

# This file is root-owned and contains only the non-secret values validated
# below. It is also consumed by the root-owned service drop-ins.
# shellcheck source=/dev/null
source "${CONFIG_FILE}"
: "${MCC_HTTPS_MODE:?MCC_HTTPS_MODE is required}"
: "${MCC_HTTPS_HOSTNAME:?MCC_HTTPS_HOSTNAME is required}"
: "${MCC_HTTPS_TLS_CONFIG:?MCC_HTTPS_TLS_CONFIG is required}"
: "${MCC_HTTPS_ONBOARDING_CONFIG:?MCC_HTTPS_ONBOARDING_CONFIG is required}"
: "${MCC_HTTPS_UPSTREAM:?MCC_HTTPS_UPSTREAM is required}"

MCC_HTTPS_MODE="${MCC_HTTPS_MODE,,}"
MCC_HTTPS_HOSTNAME="${MCC_HTTPS_HOSTNAME,,}"
if [[ "${MCC_HTTPS_MODE}" != "internal" && "${MCC_HTTPS_MODE}" != "public" ]]; then
  echo 'MCC_HTTPS_MODE must be "internal" or "public".' >&2
  exit 65
fi
if (( ${#MCC_HTTPS_HOSTNAME} > 253 )) || [[ "${MCC_HTTPS_HOSTNAME}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || [[ ! "${MCC_HTTPS_HOSTNAME}" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]]; then
  echo "MCC_HTTPS_HOSTNAME must be a valid DNS hostname without a scheme, port, path, or trailing dot." >&2
  exit 65
fi
if [[ ! "${MCC_HTTPS_UPSTREAM}" =~ ^127\.0\.0\.1:(4273|4274)$ ]]; then
  echo "MCC_HTTPS_UPSTREAM must be 127.0.0.1:4273 (production) or 127.0.0.1:4274 (staging)." >&2
  exit 65
fi
if [[ ! "${MCC_HTTPS_TLS_CONFIG}" =~ ^/etc/caddy/[A-Za-z0-9._-]+\.caddy$ || ! -r "${MCC_HTTPS_TLS_CONFIG}" ]]; then
  echo "MCC_HTTPS_TLS_CONFIG must name a readable .caddy file directly under /etc/caddy." >&2
  exit 78
fi
if [[ "$(stat -c '%U:%G:%a' "${MCC_HTTPS_TLS_CONFIG}")" != "root:root:644" ]]; then
  echo "${MCC_HTTPS_TLS_CONFIG} must be owned by root:root with mode 0644." >&2
  exit 78
fi
if [[ ! "${MCC_HTTPS_ONBOARDING_CONFIG}" =~ ^/etc/caddy/mcc-onboarding-(disabled|http)\.caddy$ || ! -r "${MCC_HTTPS_ONBOARDING_CONFIG}" ]]; then
  echo "MCC_HTTPS_ONBOARDING_CONFIG must select a readable supported onboarding fragment." >&2
  exit 78
fi
if [[ "$(stat -c '%U:%G:%a' "${MCC_HTTPS_ONBOARDING_CONFIG}")" != "root:root:644" ]]; then
  echo "${MCC_HTTPS_ONBOARDING_CONFIG} must be owned by root:root with mode 0644." >&2
  exit 78
fi
if [[ "${MCC_HTTPS_ONBOARDING_CONFIG}" == "/etc/caddy/mcc-onboarding-http.caddy" ]]; then
  if [[ ! "${MCC_ONBOARDING_IP:-}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo "MCC_ONBOARDING_IP must be an IPv4 address when HTTP root onboarding is enabled." >&2
    exit 65
  fi
  IFS=. read -r onboarding_a onboarding_b onboarding_c onboarding_d <<< "${MCC_ONBOARDING_IP}"
  for octet in "${onboarding_a}" "${onboarding_b}" "${onboarding_c}" "${onboarding_d}"; do
    if (( 10#${octet} > 255 )); then
      echo "MCC_ONBOARDING_IP contains an invalid IPv4 octet." >&2
      exit 65
    fi
  done
fi

if [[ "${MCC_HTTPS_MODE}" == "internal" ]]; then
  if [[ "${MCC_HTTPS_HOSTNAME}" != *.local ]]; then
    echo "Internal mode requires a .local MCC_HTTPS_HOSTNAME." >&2
    exit 65
  fi
  if ! grep -Eq '^[[:space:]]*tls[[:space:]]+internal[[:space:]]*$' "${MCC_HTTPS_TLS_CONFIG}"; then
    echo "Internal mode TLS config must contain 'tls internal'." >&2
    exit 65
  fi
else
  if [[ "${MCC_HTTPS_ONBOARDING_CONFIG}" != "/etc/caddy/mcc-onboarding-disabled.caddy" ]]; then
    echo "Public certificate mode must disable internal-CA root onboarding." >&2
    exit 65
  fi
  case "${MCC_HTTPS_HOSTNAME}" in
    *.local|*.localhost|*.internal|*.home.arpa|*.example|*.example.com|*.example.net|*.example.org|*.invalid|*.test)
      echo "Public mode requires a real public DNS hostname, not a reserved or internal name." >&2
      exit 65
      ;;
  esac
  public_tld="${MCC_HTTPS_HOSTNAME##*.}"
  if [[ ! "${public_tld}" =~ [a-z] ]]; then
    echo "Public mode requires a real public DNS hostname with a non-numeric top-level label." >&2
    exit 65
  fi
  if grep -Eq '^[[:space:]]*tls[[:space:]]+internal[[:space:]]*$' "${MCC_HTTPS_TLS_CONFIG}"; then
    echo "Public mode must not use Caddy's internal issuer." >&2
    exit 65
  fi
  dns_provider="$(sed -nE 's/^[[:space:]]*dns[[:space:]]+([a-z0-9_-]+).*/\1/p' "${MCC_HTTPS_TLS_CONFIG}" | head -n 1)"
  if [[ -z "${dns_provider}" || "${dns_provider}" == "dns_provider_name" ]]; then
    echo "Public mode TLS config must name the selected DNS provider in a dns directive." >&2
    exit 65
  fi
  if ! grep -Fq '{env.' "${MCC_HTTPS_TLS_CONFIG}"; then
    echo "Public mode TLS config must reference provider credentials through {env.*}; do not place secrets in the Caddyfile." >&2
    exit 65
  fi
  if ! /usr/bin/caddy list-modules | grep -Fxq "dns.providers.${dns_provider}"; then
    echo "The installed Caddy binary does not include dns.providers.${dns_provider}." >&2
    exit 69
  fi
  if [[ ! -r "${DNS_ENV_FILE}" || "$(stat -c '%U:%G:%a' "${DNS_ENV_FILE}")" != "root:root:600" ]]; then
    echo "Public mode requires ${DNS_ENV_FILE} owned by root:root with mode 0600." >&2
    exit 78
  fi
  # The provider credentials are exported only for Caddy validation and are
  # normally loaded by systemd. This root-only file must use shell-safe values.
  set -a
  # shellcheck source=/dev/null
  source "${DNS_ENV_FILE}"
  set +a
fi

/usr/sbin/runuser -u caddy -- /usr/bin/env \
  HOME=/var/lib/caddy \
  MCC_HTTPS_MODE="${MCC_HTTPS_MODE}" \
  MCC_HTTPS_HOSTNAME="${MCC_HTTPS_HOSTNAME}" \
  MCC_HTTPS_TLS_CONFIG="${MCC_HTTPS_TLS_CONFIG}" \
  MCC_HTTPS_ONBOARDING_CONFIG="${MCC_HTTPS_ONBOARDING_CONFIG}" \
  MCC_ONBOARDING_IP="${MCC_ONBOARDING_IP:-}" \
  MCC_HTTPS_UPSTREAM="${MCC_HTTPS_UPSTREAM}" \
  /usr/bin/caddy validate --config "${CADDYFILE}" --adapter caddyfile

echo "MCC HTTPS ${MCC_HTTPS_MODE} configuration is valid for ${MCC_HTTPS_HOSTNAME} -> ${MCC_HTTPS_UPSTREAM}."
