# Public-CA DNS-01 example. Do not install unchanged: replace the reserved
# example hostname after the administrator supplies the real registered name.
MCC_HTTPS_MODE=public
MCC_HTTPS_HOSTNAME=mcc.example
MCC_HTTPS_TLS_CONFIG=/etc/caddy/mcc-tls-public-dns.caddy
MCC_HTTPS_ONBOARDING_CONFIG=/etc/caddy/mcc-onboarding-disabled.caddy

# This value must remain loopback-only. Production uses 4273; staging uses 4274.
MCC_HTTPS_UPSTREAM=127.0.0.1:4273
