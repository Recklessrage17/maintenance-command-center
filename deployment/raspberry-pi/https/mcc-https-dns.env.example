# Install as /etc/mcc-https-dns.env with owner root:root and mode 0600.
# Replace the variable name(s) and value(s) with those required by the selected
# Caddy DNS provider. Never commit the populated file or place secrets in the
# Caddyfile/TLS fragment. Do not install this example unchanged.
DNS_PROVIDER_API_TOKEN=replace-with-a-least-privilege-dns-api-token
