# Internal-CA fallback example. Install as /etc/mcc-https.env with owner
# root:root and mode 0644. Use a hostname that resolves to this Pi on the LAN.
MCC_HTTPS_MODE=internal
MCC_HTTPS_HOSTNAME=mcc.local
MCC_HTTPS_TLS_CONFIG=/etc/caddy/mcc-tls-internal.caddy
MCC_HTTPS_ONBOARDING_CONFIG=/etc/caddy/mcc-onboarding-disabled.caddy

# Optional internal-CA onboarding after installing the reviewed HTTP fragment:
# MCC_ONBOARDING_IP=replace-with-the-approved-pi-lan-ip
# MCC_HTTPS_ONBOARDING_CONFIG=/etc/caddy/mcc-onboarding-http.caddy

# This value must be a loopback address. Production uses 4273; staging uses 4274.
MCC_HTTPS_UPSTREAM=127.0.0.1:4273
